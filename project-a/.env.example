# Copy this to .env and fill in values
# Never commit .env to git

# PostgreSQL
POSTGRES_USER=projecta
POSTGRES_PASSWORD=changeme
POSTGRES_DB=projecta_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# FastAPI
SECRET_KEY=changeme-use-openssl-rand-hex-32
